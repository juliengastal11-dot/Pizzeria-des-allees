---
import { Picture } from "astro:assets";
import fresque from "../assets/images/fresque.jpg";
import vignes from "../assets/images/vignes.jpg";
import { enLettres, site } from "../config/site";

const n = site.livraison.communes.length;
const livraison = `Béziers et ${enLettres(n)} commune${n > 1 ? "s" : ""} voisine${n > 1 ? "s" : ""}`;
---

<section id="maison" aria-labelledby="titre-maison" class="section maison">
  <div class="conteneur">
    <div class="haut">
      <div class="texte">
        <p class="surtitre" data-reveal="up">La maison</p>
        <h2 id="titre-maison" data-reveal="up" data-delay="60">Même adresse, <em>nouvelle enseigne.</em></h2>
        <p class="intro" data-reveal="up" data-delay="120">
          Au 43 des Allées Paul Riquet, en plein centre de Béziers. La salle s’installe sous une grande fresque du Pont Vieux et de la cathédrale Saint-Nazaire ; la terrasse donne sur les Allées.
        </p>
      </div>

      <div class="photos">
        <figure data-reveal="up" data-delay="80">
          <div class="cadre cadre-fresque photo-cadre">
            <Picture
              src={fresque}
              formats={["avif", "webp"]}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1248px) 640px, (min-width: 1024px) 50vw, 100vw"
              alt="La salle principale : tables en chêne clair sous une grande fresque de Béziers, avec la cathédrale Saint-Nazaire et le Pont Vieux"
              class="image"
              pictureAttributes={{ class: "image-cadre" }}
            />
          </div>
          <figcaption>La fresque du Pont Vieux</figcaption>
        </figure>
        <figure data-reveal="up" data-delay="200">
          <div class="cadre cadre-vignes photo-cadre">
            <Picture
              src={vignes}
              formats={["avif", "webp"]}
              widths={[360, 540, 780, 1046]}
              sizes="(min-width: 1248px) 400px, (min-width: 1024px) 30vw, (min-width: 640px) 40vw, 100vw"
              alt="Le coin des vignes : une fresque de vignoble, un cadre végétal en chêne et des tables dressées"
              class="image"
              pictureAttributes={{ class: "image-cadre" }}
            />
          </div>
          <figcaption>Le coin des vignes</figcaption>
        </figure>
      </div>
    </div>

    <dl class="faits">
      <div class="fait panneau" data-reveal="up">
        <dt class="libelle">Sur place</dt>
        <dd>
          {site.capacite.texte}
          {!site.capacite.confirmee && <span class="badge badge-outline">à confirmer</span>}
        </dd>
      </div>
      <div class="fait panneau" data-reveal="up" data-delay="60">
        <dt class="libelle">Livraison</dt>
        <dd>{livraison}</dd>
      </div>
      <div class="fait panneau" data-reveal="up" data-delay="120">
        <dt class="libelle">Paiement</dt>
        <dd>{site.paiements}</dd>
      </div>
      <div class="fait panneau" data-reveal="up" data-delay="180">
        <dt class="libelle">Avis Google</dt>
        <dd class="chiffres">
          {site.avisGoogle.note} · {site.avisGoogle.nombre}
          <span class="releve">Relevé le {site.avisGoogle.releve}</span>
        </dd>
      </div>
    </dl>
    <p class="a-valider note">
      Capacité à valider. La fiche Google des avis porte encore l’ancien nom (Basilic &amp; Co) : à faire renommer avant d’y renvoyer depuis le site.
    </p>
  </div>
</section>

<style>
  .haut {
    display: grid;
    gap: var(--space-xxl);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .haut {
      grid-template-columns: 5fr 7fr;
      gap: 80px;
    }
  }
  .texte {
    max-width: 520px;
  }
  .texte h2 {
    margin-bottom: var(--space-lg);
  }
  .intro {
    line-height: 1.6;
    text-wrap: pretty;
  }

  .photos {
    display: grid;
    gap: var(--space-base);
    align-items: end;
  }
  @media (min-width: 640px) {
    .photos {
      grid-template-columns: 1.6fr 1fr;
    }
  }
  .cadre {
    position: relative;
    border-radius: var(--radius-xl);
    background: var(--color-surface-strong);
  }
  .cadre-fresque {
    aspect-ratio: 1536 / 932;
  }
  .cadre-vignes {
    aspect-ratio: 1046 / 932;
  }
  .cadre :global(.image-cadre) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .cadre :global(.image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: var(--space-sm);
    font-size: 14px;
    letter-spacing: 0;
  }

  .faits {
    display: grid;
    gap: var(--space-base);
    margin: var(--space-xxl) 0 0;
  }
  @media (min-width: 640px) {
    .faits {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .faits {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .fait dd {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    margin: var(--space-sm) 0 0;
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
  }
  .releve {
    color: var(--color-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
  }
  .note {
    margin-top: var(--space-lg);
  }
</style>
