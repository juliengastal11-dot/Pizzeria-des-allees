---
import { Picture } from "astro:assets";
import devanture from "../assets/images/devanture.jpg";
import { commande, site } from "../config/site";
---

<section id="accueil" aria-labelledby="titre-accueil" class="hero">
  <div class="orbes" aria-hidden="true" data-intro="orbe" data-intro-delay="0">
    <span class="orbe orbe-peche"></span>
    <span class="orbe orbe-rose"></span>
    <span class="orbe orbe-menthe"></span>
  </div>

  <div class="conteneur">
    <h1 id="titre-accueil">
      <span class="ligne"><span data-intro="rise" data-intro-delay="200">La Pizzeria <em>des Allées</em></span></span>
      <span class="sr-only">, pizzeria à Béziers</span>
    </h1>
    <p class="accroche" data-intro="fade" data-intro-delay="380">
      Sur les Allées Paul Riquet, au cœur de Béziers. En salle, en terrasse, à emporter ou livrée chez vous.
    </p>
    <div class="boutons" data-intro="fade" data-intro-delay="480" data-cta-zone="hero">
      <a class="btn btn-primary btn-grand" href="#reserver" data-reserver>Réserver une table</a>
      <a class="btn btn-outline btn-grand" href={commande.href} target={commande.target} rel={commande.rel}>Commander</a>
      <a class="btn btn-text btn-grand" href="#venir">Nous trouver</a>
    </div>
    <p class="note-google chiffres" data-intro="fade" data-intro-delay="580">
      <span class="note">{site.avisGoogle.note}</span> sur Google · {site.avisGoogle.nombre}
    </p>

    <figure class="visuel photo-cadre" data-intro="visuel" data-intro-delay="680">
      <Picture
        src={devanture}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="(min-width: 1248px) 1200px, 100vw"
        priority
        alt="La devanture de La Pizzeria des Allées le soir : l’enseigne bleu nuit aux lettres dorées, et des convives qui dînent en terrasse"
        class="image"
        pictureAttributes={{ class: "image-cadre" }}
      />
      <!--
        La devanture qui vit en boucle (convives, pizzaiolo). Sa première image est la photo :
        aucun saut quand elle démarre. Lancée par scripts/devanture.ts, après l'entrée animée.
      -->
      <video
        class="video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        disableRemotePlayback
        aria-hidden="true"
        tabindex="-1"
        data-video-devanture
      >
        <source src="/video/devanture-convives.webm" type="video/webm" media="(min-width: 768px)" />
        <source src="/video/devanture-convives.mp4" type="video/mp4" media="(min-width: 768px)" />
        <source src="/video/devanture-convives-720.webm" type="video/webm" />
        <source src="/video/devanture-convives-720.mp4" type="video/mp4" />
      </video>
    </figure>
    <p class="a-valider note-valider">Photo et vidéo provisoires, retouchée et animée par IA : à remplacer par le reportage de la réouverture.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    /* Remonte sous l'en-tête transparent : le dégradé passe derrière lui */
    margin-top: calc(-1 * var(--hauteur-entete));
    padding-block: calc(var(--hauteur-entete) + 40px) 0;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero {
      padding-block: calc(var(--hauteur-entete) + 56px) 0;
    }
  }

  /* Grandes taches pastel derrière le titre : de l'atmosphère, jamais un fond de composant */
  .orbes {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }
  .orbe {
    position: absolute;
    left: 50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--teinte) 0%, transparent 100%);
    animation: derive 34s ease-in-out infinite alternate;
  }
  .orbe-peche {
    --teinte: var(--color-orb-peach);
    top: -190px;
    width: min(96vw, 820px);
    aspect-ratio: 1;
    margin-left: max(-48vw, -410px);
    opacity: 0.85;
  }
  .orbe-rose {
    --teinte: var(--color-orb-rose);
    top: -150px;
    width: min(72vw, 600px);
    aspect-ratio: 1;
    margin-left: max(-6vw, -20px);
    opacity: 0.7;
    animation-duration: 41s;
    animation-delay: -14s;
  }
  .orbe-menthe {
    --teinte: var(--color-orb-mint);
    top: 120px;
    width: min(64vw, 520px);
    aspect-ratio: 1;
    margin-left: max(-52vw, -560px);
    opacity: 0.55;
    animation-duration: 47s;
    animation-delay: -22s;
  }
  @keyframes derive {
    from {
      transform: translate3d(-3%, -2%, 0) scale(1);
    }
    to {
      transform: translate3d(4%, 3%, 0) scale(1.08);
    }
  }

  .ligne {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .ligne > span {
    display: block;
  }
  .accroche {
    max-width: 560px;
    margin: var(--space-lg) auto 0;
    font-size: 16px;
    text-wrap: pretty;
  }
  @media (min-width: 640px) {
    .accroche {
      font-size: 18px;
    }
  }
  .boutons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }
  .note-google {
    margin-top: var(--space-lg);
    font-size: 14px;
    letter-spacing: 0;
  }
  .note {
    color: var(--color-ink);
    font-weight: 500;
  }

  /* La carte photo : 16/9 (l'image entière), un peu plus haute sur téléphone, sans jamais rogner l'enseigne */
  .visuel {
    position: relative;
    margin-top: 48px;
    border-radius: var(--radius-xl);
    background: #0b0a09;
    aspect-ratio: 8 / 5;
  }
  @media (min-width: 640px) {
    .visuel {
      aspect-ratio: 16 / 9;
    }
  }
  .visuel :global(.image-cadre) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .visuel :global(.image),
  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Posée sur la photo, invisible jusqu'à ce que la lecture démarre, puis en fondu */
  .video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }
  .video[data-lecture] {
    opacity: 1;
  }
  .note-valider {
    margin-top: var(--space-base);
    text-align: left;
  }
</style>
