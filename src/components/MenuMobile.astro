---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import { commande, site } from "../config/site";
---

<!--
  Menu plein écran (moins de 1024 px). Fenêtre modale native : le reste de la
  page devient inerte, Échap la ferme et le focus revient au bouton Menu.
-->
<dialog id="menu-mobile" class="menu" aria-label="Menu" data-menu>
  <div class="orbe" aria-hidden="true"></div>
  <div class="tete">
    <Image src={logo} width={36} height={36} densities={[1, 2]} alt="" class="logo" />
    <button type="button" class="btn btn-outline" autofocus data-fermer>Fermer</button>
  </div>
  <nav aria-label="Sections de la page" class="nav">
    <a data-menu-item href="#maison">La maison</a>
    <a data-menu-item href="#carte">La carte</a>
    <a data-menu-item href="#livraison">Livraison</a>
    <a data-menu-item href="#venir">Nous trouver</a>
  </nav>
  <div data-menu-item class="actions">
    <a class="btn btn-primary btn-grand" href="#reserver" data-reserver>Réserver</a>
    <a class="btn btn-outline btn-grand" href={commande.href} target={commande.target} rel={commande.rel}>Commander</a>
    <a class="btn btn-outline btn-grand appeler chiffres" href={`tel:${site.telephoneInternational}`} data-reste-ouvert>Appeler le {site.telephone}</a>
  </div>
</dialog>

<style>
  .menu {
    position: fixed;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: var(--space-sm) var(--gutter) calc(var(--space-lg) + env(safe-area-inset-bottom));
    background: var(--color-canvas);
    color: var(--color-body);
    overflow-x: hidden;
    overflow-y: auto;
  }
  /* Ne s'affiche qu'ouvert : sans [open], le navigateur garde la fenêtre masquée */
  .menu[open] {
    display: flex;
    flex-direction: column;
  }
  .menu::backdrop {
    background: transparent;
  }
  .orbe {
    position: fixed;
    z-index: -1;
    left: -30%;
    right: -30%;
    bottom: -25%;
    height: 70%;
    background: radial-gradient(50% 50% at 50% 50%, var(--color-orb-peach), transparent 100%);
    opacity: 0.7;
    pointer-events: none;
  }
  .tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    height: 52px;
  }
  .logo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }
  .nav {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-xxl);
    border-top: 1px solid var(--color-hairline);
  }
  .nav a {
    padding: var(--space-base) 0;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
    margin-top: auto;
    padding-top: var(--space-xl);
  }
  .appeler {
    grid-column: 1 / -1;
  }
</style>
