---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { commande, site } from "../config/site";

// Les photos des pizzas, retrouvées par leur identifiant (src/assets/images/pizzas/<id>.webp)
const fichiers = import.meta.glob<{ default: ImageMetadata }>("../assets/images/pizzas/*.webp", { eager: true });
const photo = (id: string) => {
  const f = fichiers[`../assets/images/pizzas/${id}.webp`];
  if (!f) throw new Error(`Photo manquante pour la pizza « ${id} » (src/assets/images/pizzas/${id}.webp)`);
  return f.default;
};

const pizzas = site.pizzas.map((p) => {
  const tags: string[] = [];
  if (p.vegetarienne) tags.push("Végétarienne");
  if (p.pimentee) tags.push("Pimentée");
  if (p.duMoment) tags.push("Du moment");
  return {
    ...p,
    image: photo(p.id),
    alt: `${p.nom} : ${p.description.toLowerCase()}`,
    baseLabel: p.base === "tomate" ? "Base tomate" : "Base crème",
    tags,
  };
});
const filtres: [string, string][] = [
  ["toutes", "Toutes"],
  ["tomate", "Base tomate"],
  ["crème", "Base crème"],
];
---

<section id="carte" aria-labelledby="titre-carte" class="carte" data-carte>
  <div class="contenu">
    <div class="tete">
      <div class="tete-texte">
        <p class="surtitre" data-reveal="up">La carte</p>
        <h2 id="titre-carte" class="titre-section" data-reveal="up" data-delay="60">Une sélection <em>de la maison</em></h2>
        <div class="tete-intro" data-reveal="up" data-delay="120">
          <p>Six pizzas pour découvrir la maison. La carte complète et les prix seront disponibles avec la commande en ligne.</p>
          <span class="tag tag-outline">Recettes à confirmer</span>
        </div>
      </div>
      <div class="seg" role="radiogroup" aria-label="Filtrer les pizzas par base" data-reveal="up" data-delay="160">
        {
          filtres.map(([valeur, libelle], i) => (
            <label class="seg-opt filtre">
              <input type="radio" name="base-pizza" value={valeur} checked={i === 0} data-filtre />
              {libelle}
            </label>
          ))
        }
      </div>
    </div>

    <!-- Ordinateur : la liste à gauche, la pizza choisie à droite -->
    <div class="ordi sur-ordi">
      <ul role="list" class="liste">
        {
          pizzas.map((p, i) => (
            <li data-reveal="up" data-pizza={p.id} data-base={p.base} data-actif={i === 0 ? "" : undefined}>
              <button type="button" class="choix" aria-pressed={i === 0 ? "true" : "false"} aria-controls="scene-carte" data-choisir>
                <span class="choix-point" aria-hidden="true" />
                <span class="choix-nom">{p.nom}</span>
                <span class="libelle choix-base">{p.baseLabel}</span>
                <span class="choix-details">
                  <span class="choix-repli">
                    <span class="choix-description">{p.description}</span>
                    <span class="choix-tags">
                      {p.tags.map((t) => (
                        <span class="tag tag-outline">{t}</span>
                      ))}
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <div id="scene-carte" class="scene" data-reveal="fade">
        <div class="scene-lueur" aria-hidden="true"></div>
        <div class="scene-ombre" aria-hidden="true"></div>
        {
          pizzas.map((p, i) => (
            <Image
              src={p.image}
              alt={p.alt}
              widths={[400, 640, 800]}
              sizes="(min-width: 1320px) 600px, 45vw"
              class="scene-pizza"
              data-pizza={p.id}
              data-etat={i === 0 ? "actif" : "autre"}
              aria-hidden={i === 0 ? "false" : "true"}
            />
          ))
        }
      </div>
    </div>

    <!-- Téléphone : un carrousel à faire défiler -->
    <div class="mobile sur-mobile">
      <div class="piste" role="list" aria-label="Pizzas de la sélection, à faire défiler" data-piste>
        {
          pizzas.map((p, i) => (
            <article
              role="listitem"
              class="diapo"
              data-pizza={p.id}
              data-base={p.base}
              data-reveal="monte"
              data-delay={(i % 3) * 90 + Math.floor(i / 3) * 140}
            >
              <div class="diapo-photo">
                <div class="diapo-lueur" aria-hidden="true" />
                <!-- La pizza roule en traversant le centre (scripts/carte.ts), et se soulève au survol -->
                <div class="diapo-roule" data-roule>
                  <div class="diapo-leve">
                    <Image src={p.image} alt={p.alt} widths={[400, 640, 800]} sizes="80vw" class="diapo-pizza" />
                  </div>
                </div>
              </div>
              <h3>{p.nom}</h3>
              <p class="diapo-description">{p.description}</p>
              <div class="diapo-tags">
                <span class="tag tag-outline">{p.baseLabel}</span>
                {p.tags.map((t) => (
                  <span class="tag tag-outline">{t}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      <div class="commandes">
        <button type="button" class="btn btn-secondary fleche" aria-label="Pizza précédente" data-precedente>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg
          >
        </button>
        <p class="compteur chiffres" aria-live="polite" data-compteur>1 / {pizzas.length}</p>
        <button type="button" class="btn btn-secondary fleche" aria-label="Pizza suivante" data-suivante>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </button>
      </div>
    </div>

    <div class="pied" data-reveal="up">
      <a class="btn btn-primary pied-commander" href={commande.href} target={commande.target} rel={commande.rel}>Voir toute la carte et commander</a>
      <a class="btn btn-secondary pied-reserver" href="#reserver" data-reserver>Réserver une table</a>
      <p class="a-valider note">
        Sélection et recettes reprises du site actuel, à valider avec le pizzaïolo. Pizzas générées par IA en attendant les vraies photos. Pas de prix ici : ils vivront dans Obypay.
      </p>
    </div>
  </div>
</section>

<style>
  .carte {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    scroll-margin-top: 64px;
    padding: clamp(88px, 11vw, 160px) clamp(16px, 3vw, 44px);
    background: #171514;
    border-top: 1px solid var(--color-divider);
  }
  .contenu {
    max-width: 1320px;
    margin: 0 auto;
  }
  .tete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .tete-texte {
    flex: 1 1 520px;
    min-width: 0;
  }
  .tete-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 22px;
  }
  .tete-intro p {
    margin: 0;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-text) 84%, transparent);
  }
  .tete-intro .tag {
    font-size: 12px;
  }
  .filtre {
    min-height: 44px;
    padding: 0 16px;
    font-family: var(--font-heading);
    font-size: 17px;
  }

  /* Ordinateur */
  .ordi {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  @media (min-width: 860px) {
    .ordi {
      display: grid;
    }
  }
  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-divider);
  }
  .liste li {
    border-bottom: 1px solid var(--color-divider);
  }
  .liste li[hidden] {
    display: none;
  }
  .choix {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 14px;
    width: 100%;
    margin: 0;
    padding: 20px 4px;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .choix-point {
    display: block;
    width: 0;
    height: 8px;
    border-radius: 4px;
    background: var(--color-tomato);
    box-shadow: 0 0 10px 1px rgba(196, 81, 58, 0.6);
    align-self: center;
    transition: width 0.4s var(--ease-out);
  }
  .choix-nom {
    font-family: var(--font-heading);
    font-size: clamp(30px, 2.9vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color 0.3s ease;
  }
  .choix-base {
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--color-text) 64%, transparent);
  }
  .choix-details {
    grid-column: 2 / -1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-out);
  }
  .choix-repli {
    overflow: hidden;
    min-height: 0;
  }
  .choix-description {
    display: block;
    padding-top: 10px;
    font-size: 16px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
  }
  .choix-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 10px;
  }
  .choix-tags .tag {
    font-size: 12px;
  }
  /* La pizza choisie */
  li[data-actif] .choix-point {
    width: 22px;
  }
  li[data-actif] .choix-nom {
    color: var(--color-accent-300);
    font-style: italic;
  }
  li[data-actif] .choix-details {
    grid-template-rows: 1fr;
  }
  .scene {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 640px;
    justify-self: center;
  }
  .scene-lueur {
    position: absolute;
    inset: -18%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 54%, rgba(196, 81, 58, 0.26) 0%, rgba(194, 141, 65, 0.09) 50%, rgba(23, 21, 20, 0) 72%);
  }
  .scene-ombre {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 2%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  }
  /*
   * Les pizzas en attente ne tournent qu'à l'approche de la carte (data-proche,
   * posé par scripts/carte.ts) : Chrome télécharge d'office une image tournée,
   * même tout en bas de la page, ce qui alourdissait l'arrivée sur le site.
   */
  .scene :global(.scene-pizza) {
    position: absolute;
    inset: 3%;
    width: 94%;
    height: 94%;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.9);
    transition:
      transform 1.05s var(--ease-out),
      opacity 0.55s ease;
    filter: drop-shadow(0 28px 36px rgba(0, 0, 0, 0.5));
  }
  .scene[data-proche] :global(.scene-pizza) {
    transform: rotate(-80deg) scale(0.9);
  }
  .scene :global(.scene-pizza[data-etat="actif"]) {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  /* La précédente repart dans l'autre sens */
  .scene[data-proche] :global(.scene-pizza[data-etat="precedente"]) {
    transform: rotate(80deg) scale(0.9);
  }

  /* Souris : la pizza tourne de 25° et se soulève de 10 px (jamais au toucher, ni en animations réduites) */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .scene:hover :global(.scene-pizza[data-etat="actif"]) {
      transform: rotate(25deg) translateY(-10px);
      transition:
        transform 0.8s var(--ressort),
        opacity 0.55s ease;
    }
    .diapo:hover .diapo-leve {
      transform: rotate(25deg) translateY(-10px);
    }
  }

  /* Téléphone */
  .piste {
    position: relative;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 0 -16px;
    padding: 0 16px 8px;
    scrollbar-width: none;
  }
  .piste::-webkit-scrollbar {
    display: none;
  }
  .diapo {
    flex: 0 0 80%;
    scroll-snap-align: center;
    min-width: 0;
  }
  .diapo[hidden] {
    display: none;
  }
  .diapo-photo {
    position: relative;
    aspect-ratio: 1 / 1;
  }
  .diapo-lueur {
    position: absolute;
    inset: -10%;
    background: radial-gradient(50% 50% at 50% 54%, rgba(196, 81, 58, 0.24) 0%, rgba(23, 21, 20, 0) 70%);
  }
  /* Deux calques : le premier roule avec le défilement, le second se soulève au survol */
  .diapo-roule {
    position: absolute;
    inset: 0;
    will-change: rotate, scale;
  }
  .diapo-leve {
    position: absolute;
    inset: 4%;
    transition: transform 0.8s var(--ressort);
  }
  .diapo-photo :global(.diapo-pizza) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.5));
  }
  .diapo h3 {
    margin: 14px 0 0;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.05;
  }
  .diapo-description {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
  }
  .diapo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .diapo-tags .tag {
    font-size: 12px;
  }
  .commandes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
  }
  .fleche {
    width: 48px;
    height: 48px;
    padding: 0;
  }
  .compteur {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 18px;
  }

  .pied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: clamp(40px, 5vw, 72px);
    padding-top: 28px;
    border-top: 1px solid var(--color-divider);
  }
  .pied-commander {
    min-height: 50px;
    padding: 0 24px;
    font-size: 18px;
  }
  .pied-reserver {
    min-height: 50px;
    padding: 0 22px;
    font-size: 18px;
  }
  .note {
    flex: 1 1 280px;
    margin: 0;
  }
</style>
