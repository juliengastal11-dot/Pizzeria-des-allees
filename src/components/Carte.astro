---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { commande, site } from "../config/site";

// Les photos des pizzas, retrouvées par leur identifiant (src/assets/images/pizzas/<id>.webp)
const fichiers = import.meta.glob<{ default: ImageMetadata }>("../assets/images/pizzas/*.webp", { eager: true });
const photo = (id: string) => {
  const f = fichiers[`../assets/images/pizzas/${id}.webp`];
  if (!f) throw new Error(`Photo manquante pour la pizza « ${id} » (src/assets/images/pizzas/${id}.webp)`);
  return f.default;
};

const pizzas = site.pizzas.map((p) => {
  const tags: string[] = [];
  if (p.vegetarienne) tags.push("Végétarienne");
  if (p.pimentee) tags.push("Pimentée");
  if (p.duMoment) tags.push("Du moment");
  return {
    ...p,
    image: photo(p.id),
    alt: `${p.nom} : ${p.description.toLowerCase()}`,
    baseLabel: p.base === "tomate" ? "Base tomate" : "Base crème",
    tags,
  };
});
const filtres: [string, string][] = [
  ["toutes", "Toutes"],
  ["tomate", "Base tomate"],
  ["crème", "Base crème"],
];
---

<section id="carte" aria-labelledby="titre-carte" class="section carte" data-carte>
  <div class="conteneur">
    <div class="tete">
      <div class="tete-texte">
        <p class="surtitre" data-reveal="up">La carte</p>
        <h2 id="titre-carte" data-reveal="up" data-delay="60">Une sélection <em>de la maison</em></h2>
        <div class="tete-intro" data-reveal="up" data-delay="120">
          <p>Six pizzas pour découvrir la maison. La carte complète et les prix seront disponibles avec la commande en ligne.</p>
          <span class="badge badge-outline">Recettes à confirmer</span>
        </div>
      </div>
      <div class="seg" role="radiogroup" aria-label="Filtrer les pizzas par base" data-reveal="up" data-delay="160">
        {
          filtres.map(([valeur, libelle], i) => (
            <label class="seg-opt">
              <input type="radio" name="base-pizza" value={valeur} checked={i === 0} data-filtre />
              {libelle}
            </label>
          ))
        }
      </div>
    </div>

    <!-- Ordinateur : la liste à gauche, la pizza choisie à droite -->
    <div class="ordi sur-ordi">
      <ul role="list" class="liste">
        {
          pizzas.map((p, i) => (
            <li data-reveal="up" data-pizza={p.id} data-base={p.base} data-actif={i === 0 ? "" : undefined}>
              <button type="button" class="choix" aria-pressed={i === 0 ? "true" : "false"} aria-controls="scene-carte" data-choisir>
                <span class="choix-vignette" aria-hidden="true">
                  <Image src={p.image} alt="" width={112} height={112} loading="lazy" class="choix-image" />
                </span>
                <span class="choix-nom">{p.nom}</span>
                <span class="badge choix-base">{p.baseLabel}</span>
                <span class="choix-details">
                  <span class="choix-repli">
                    <span class="choix-description">{p.description}</span>
                    <span class="choix-tags">
                      {p.tags.map((t) => (
                        <span class="badge badge-outline">{t}</span>
                      ))}
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <div id="scene-carte" class="scene" data-reveal="fade">
        <div class="scene-orbe" aria-hidden="true"></div>
        <div class="scene-ombre" aria-hidden="true"></div>
        {
          pizzas.map((p, i) => (
            <Image
              src={p.image}
              alt={p.alt}
              widths={[400, 640, 800]}
              sizes="(min-width: 1248px) 480px, 45vw"
              class="scene-pizza"
              data-pizza={p.id}
              data-etat={i === 0 ? "actif" : "autre"}
              aria-hidden={i === 0 ? "false" : "true"}
            />
          ))
        }
      </div>
    </div>

    <!-- Téléphone : un carrousel à faire défiler -->
    <div class="mobile sur-mobile">
      <div class="piste" role="list" aria-label="Pizzas de la sélection, à faire défiler" data-piste>
        {
          pizzas.map((p, i) => (
            <article
              role="listitem"
              class="diapo"
              data-pizza={p.id}
              data-base={p.base}
              data-reveal="monte"
              data-delay={(i % 3) * 90 + Math.floor(i / 3) * 140}
            >
              <div class="diapo-photo">
                <div class="diapo-orbe" aria-hidden="true"></div>
                <!-- La pizza roule en traversant le centre (scripts/carte.ts), et se soulève au survol -->
                <div class="diapo-roule" data-roule>
                  <div class="diapo-leve">
                    <Image src={p.image} alt={p.alt} widths={[400, 640, 800]} sizes="80vw" class="diapo-pizza" />
                  </div>
                </div>
              </div>
              <h3>{p.nom}</h3>
              <p class="diapo-description">{p.description}</p>
              <div class="diapo-tags">
                <span class="badge">{p.baseLabel}</span>
                {p.tags.map((t) => (
                  <span class="badge badge-outline">{t}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      <div class="commandes">
        <button type="button" class="btn btn-outline fleche" aria-label="Pizza précédente" data-precedente>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg
          >
        </button>
        <p class="compteur chiffres" aria-live="polite" data-compteur>1 / {pizzas.length}</p>
        <button type="button" class="btn btn-outline fleche" aria-label="Pizza suivante" data-suivante>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </button>
      </div>
    </div>

    <div class="pied" data-reveal="up">
      <a class="btn btn-primary" href={commande.href} target={commande.target} rel={commande.rel}>Voir toute la carte et commander</a>
      <a class="btn btn-outline" href="#reserver" data-reserver>Réserver une table</a>
      <p class="a-valider note">
        Sélection et recettes reprises du site actuel, à valider avec le pizzaïolo. Pizzas générées par IA en attendant les vraies photos. Pas de prix ici : ils vivront dans Obypay.
      </p>
    </div>
  </div>
</section>

<style>
  .carte {
    background: var(--color-canvas-soft);
    border-block: 1px solid var(--color-hairline);
    overflow: hidden;
    overflow: clip;
  }
  .tete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg) var(--space-xxl);
    margin-bottom: var(--space-xxl);
  }
  .tete-texte {
    flex: 1 1 480px;
    min-width: 0;
  }
  .tete-texte h2 {
    margin-bottom: var(--space-base);
  }
  .tete-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-base);
  }
  .tete-intro p {
    max-width: 46ch;
  }

  /* Ordinateur */
  .ordi {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  @media (min-width: 768px) {
    .ordi {
      display: grid;
    }
  }
  .liste {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .choix {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 var(--space-base);
    width: 100%;
    margin: 0;
    padding: var(--space-sm) var(--space-base) var(--space-sm) var(--space-sm);
    border: 1px solid transparent;
    border-radius: var(--radius-xl);
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: pointer;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
  }
  .choix:hover {
    background: var(--color-surface-strong);
  }
  .choix-vignette {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-surface-strong);
    overflow: hidden;
    overflow: clip;
  }
  .choix-image {
    width: 88%;
    height: 88%;
    object-fit: contain;
  }
  .choix-nom {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .choix-details {
    grid-column: 2 / -1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-out);
  }
  .choix-repli {
    min-height: 0;
    overflow: hidden;
  }
  .choix-description {
    display: block;
    padding-top: var(--space-xs);
    font-size: 15px;
    line-height: 1.5;
  }
  .choix-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: var(--space-sm);
  }
  /* La pizza choisie : carte blanche */
  li[data-actif] .choix {
    border-color: var(--color-hairline);
    background: var(--color-surface);
  }
  li[data-actif] .choix-details {
    grid-template-rows: 1fr;
  }

  /* La scène : grande carte pastel où la pizza choisie tourne */
  .scene {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xxl);
    background: var(--color-canvas);
    overflow: hidden;
    overflow: clip;
  }
  .scene-orbe,
  .diapo-orbe {
    position: absolute;
    inset: -8%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--color-orb-peach) 56%, var(--color-orb-rose) 82%, transparent 100%);
    opacity: 0.85;
  }
  .scene-ombre {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 8%;
    height: 8%;
    border-radius: 50%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(41, 37, 36, 0.28), transparent);
  }
  /*
   * Les pizzas en attente ne tournent qu'à l'approche de la carte (data-proche, posé
   * par scripts/carte.ts) : Chrome télécharge d'office une image tournée, même tout
   * en bas de la page, ce qui alourdissait l'arrivée sur le site.
   */
  .scene :global(.scene-pizza) {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.9);
    transition:
      transform 1.05s var(--ease-out),
      opacity 0.55s ease;
    filter: drop-shadow(0 22px 24px rgba(41, 37, 36, 0.22));
  }
  .scene[data-proche] :global(.scene-pizza) {
    transform: rotate(-80deg) scale(0.9);
  }
  .scene :global(.scene-pizza[data-etat="actif"]) {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  /* La précédente repart dans l'autre sens */
  .scene[data-proche] :global(.scene-pizza[data-etat="precedente"]) {
    transform: rotate(80deg) scale(0.9);
  }

  /* Souris : la pizza tourne de 25° et se soulève de 10 px (jamais au toucher, ni en animations réduites) */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .scene:hover {
      box-shadow: var(--shadow-soft);
    }
    .scene:hover :global(.scene-pizza[data-etat="actif"]) {
      transform: rotate(25deg) translateY(-10px);
      transition:
        transform 0.8s var(--ressort),
        opacity 0.55s ease;
    }
    .diapo:hover .diapo-leve {
      transform: rotate(25deg) translateY(-10px);
    }
  }

  /* Téléphone */
  .piste {
    position: relative;
    display: flex;
    gap: var(--space-base);
    margin-inline: calc(-1 * var(--gutter));
    padding: 0 var(--gutter) var(--space-xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .piste::-webkit-scrollbar {
    display: none;
  }
  .diapo {
    flex: 0 0 80%;
    min-width: 0;
    scroll-snap-align: center;
  }
  .diapo[hidden] {
    display: none;
  }
  .diapo-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xxl);
    background: var(--color-canvas);
    overflow: hidden;
    overflow: clip;
  }
  /* Deux calques : le premier roule avec le défilement, le second se soulève au survol */
  .diapo-roule {
    position: absolute;
    inset: 0;
    will-change: rotate, scale;
  }
  .diapo-leve {
    position: absolute;
    inset: 7%;
    transition: transform 0.8s var(--ressort);
  }
  .diapo-photo :global(.diapo-pizza) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 16px 18px rgba(41, 37, 36, 0.22));
  }
  .diapo h3 {
    margin-top: var(--space-base);
    font-size: 28px;
  }
  .diapo-description {
    margin-top: var(--space-xs);
    font-size: 15px;
    line-height: 1.5;
  }
  .diapo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-sm);
  }
  .commandes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .fleche {
    width: 48px;
    height: 48px;
    padding: 0;
  }
  .compteur {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--color-ink);
  }

  .pied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-base);
    margin-top: var(--space-xxl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-hairline);
  }
  .note {
    flex: 1 1 280px;
  }
</style>
