---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import { commande, site } from "../config/site";
---

<header id="entete" class="entete">
  <div class="barre conteneur">
    <a href="#accueil" aria-label="La Pizzeria des Allées, accueil" class="marque">
      <Image src={logo} alt="" width={36} height={36} densities={[1, 2]} loading="eager" class="logo" />
      <span class="nom">La Pizzeria <em>des Allées</em></span>
    </a>
    <nav aria-label="Navigation principale" class="nav">
      <a href="#maison">La maison</a>
      <a href="#carte">La carte</a>
      <a href="#livraison">Livraison</a>
      <a href="#venir">Nous trouver</a>
    </nav>
    <a href={`tel:${site.telephoneInternational}`} class="tel chiffres">{site.telephone}</a>
    <div class="actions">
      <a class="btn btn-outline" href={commande.href} target={commande.target} rel={commande.rel}>Commander</a>
      <a class="btn btn-primary" href="#reserver" data-reserver>Réserver</a>
    </div>
    <button type="button" class="btn btn-outline menu" aria-expanded="false" aria-controls="menu-mobile" data-ouvrir-menu>Menu</button>
  </div>
</header>

<style>
  .entete {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid transparent;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
  }
  /* Transparent au-dessus du haut de page (le dégradé passe derrière), plein dès qu'on a défilé de quelques pixels (posé par le script) */
  .entete[data-defile] {
    border-bottom-color: var(--color-hairline);
    background: var(--color-canvas);
  }
  .barre {
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--hauteur-entete);
  }
  .marque {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--color-ink);
    text-decoration: none;
  }
  .logo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }
  .nom {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav {
    display: none;
    gap: 28px;
  }
  .nav a {
    color: var(--color-ink);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .tel {
    display: none;
    color: var(--color-body);
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
  }
  .actions {
    display: none;
    gap: var(--space-xs);
  }
  @media (min-width: 768px) {
    .actions {
      display: flex;
    }
  }
  @media (min-width: 1024px) {
    .nav {
      display: flex;
    }
    .menu {
      display: none;
    }
  }
  @media (min-width: 1240px) {
    .tel {
      display: inline;
    }
  }
</style>
