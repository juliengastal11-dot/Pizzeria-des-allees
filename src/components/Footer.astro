---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import { commande, site } from "../config/site";

const { instagram, facebook } = site.reseaux;
---

<footer class="pied">
  <div class="conteneur">
    <div class="grille">
      <div class="marque">
        <Image
          src={logo}
          width={56}
          height={56}
          densities={[1, 2]}
          alt="Logo de La Pizzeria des Allées : badge rond bleu nuit et or, avec la cathédrale Saint-Nazaire et le Pont Vieux"
          class="logo"
        />
        <p class="nom">La Pizzeria <em>des Allées</em></p>
      </div>
      <div>
        <h2 class="libelle titre">Nous trouver</h2>
        <p class="adresse">
          {site.adresse.rue}<br />{site.adresse.codePostal} {site.adresse.ville}<br /><a href={`tel:${site.telephoneInternational}`} class="lien-texte chiffres">{site.telephone}</a>
        </p>
      </div>
      <div>
        <h2 class="libelle titre">Sur la page</h2>
        <ul role="list" class="liens">
          <li><a href="#carte">La carte</a></li>
          <li><a href="#reserver" data-reserver>Réserver une table</a></li>
          <li><a href={commande.href} target={commande.target} rel={commande.rel}>Commander</a></li>
          <li><a href="#venir">Horaires et accès</a></li>
        </ul>
      </div>
      <div>
        <h2 class="libelle titre">Nous suivre</h2>
        <div class="liens">
          {instagram && <a href={instagram} target="_blank" rel="noopener">Instagram</a>}
          {facebook && <a href={facebook} target="_blank" rel="noopener">Facebook</a>}
          {!instagram && !facebook && <p class="bientot">Instagram et Facebook arrivent bientôt.</p>}
        </div>
      </div>
    </div>

    <div class="bas">
      <p class="provisoire">
        Visuels provisoires : photos de la salle retouchées, devanture animée et pizzas générées par IA, en attendant le reportage photo de la réouverture.
      </p>
      <div class="mentions">
        <button type="button" class="ouvrir-legal" aria-haspopup="dialog" aria-controls="fenetre-legale" data-ouvrir-legal>Mentions légales et confidentialité</button>
        <span>© {site.annee} {site.nom}</span>
        {site.legal.concepteur && <span>Site réalisé par {site.legal.concepteur}</span>}
      </div>
    </div>
    <!-- Place laissée à la barre d'actions du téléphone -->
    <div class="cale sur-mobile" aria-hidden="true"></div>
  </div>
</footer>

<style>
  .pied {
    padding-block: var(--space-xxl) var(--space-xl);
    border-top: 1px solid var(--color-hairline);
  }
  @media (min-width: 768px) {
    .pied {
      padding-block: 64px var(--space-xl);
    }
  }
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-xxl) var(--space-xl);
  }
  .marque {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .logo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
  }
  .nom {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .titre {
    margin-bottom: var(--space-sm);
  }
  .adresse {
    font-size: 15px;
    line-height: 1.7;
  }
  .liens {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  .liens a {
    color: var(--color-body);
    text-decoration: none;
  }
  .liens a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
  .bientot {
    color: var(--color-body);
  }
  .bas {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-xl);
    margin-top: var(--space-xxl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-hairline);
    font-size: 13px;
    line-height: 1.6;
    letter-spacing: 0;
  }
  .provisoire {
    flex: 1 1 420px;
    max-width: 70ch;
  }
  .mentions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--space-lg);
  }
  .ouvrir-legal {
    padding: 10px 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cale {
    height: 84px;
  }
</style>
