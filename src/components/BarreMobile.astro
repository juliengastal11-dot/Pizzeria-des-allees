---
import { commande, site } from "../config/site";
---

<!-- Téléphone : les trois actions à portée de pouce, une fois le haut de page passé (voir scripts/interface.ts) -->
<div class="barre sur-mobile" role="region" aria-label="Actions rapides" data-barre>
  <a class="btn btn-primary action" href="#reserver" data-reserver>Réserver</a>
  <a class="btn btn-outline action" href={commande.href} target={commande.target} rel={commande.rel}>Commander</a>
  <a class="btn btn-outline action" href={`tel:${site.telephoneInternational}`} aria-label={`Appeler le ${site.telephone}`}>Appeler</a>
</div>

<style>
  .barre {
    position: fixed;
    z-index: 45;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: 1.1fr 1.1fr 0.9fr;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgba(12, 10, 9, 0.1);
    transform: translateY(140%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.45s var(--ease-out),
      opacity 0.3s ease,
      visibility 0.45s;
  }
  .barre[data-visible] {
    transform: translateY(0%);
    opacity: 1;
    visibility: visible;
  }
  .action {
    min-height: 44px;
    padding: 0 var(--space-xs);
  }
</style>
