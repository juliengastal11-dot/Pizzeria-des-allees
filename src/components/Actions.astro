---
import { Picture } from "astro:assets";
import facade from "../assets/images/facade-nuit.jpg";
import { commande, enLettres, site } from "../config/site";

// Plan schématique de la livraison : la pizzeria au centre, chaque commune à sa vraie direction et distance
const KX = 111.32 * Math.cos((site.adresse.latitude * Math.PI) / 180);
const KY = 110.574;
const communes = site.livraison.communes.map((c, i) => {
  const dx = (c.longitude - site.adresse.longitude) * KX;
  const dy = (c.latitude - site.adresse.latitude) * KY;
  const left = 50 + (dx / 8) * 46;
  const top = 50 - (dy / 8.4) * 46;
  return {
    nom: c.nom,
    etiquette: c.etiquette,
    km: `≈ ${Math.round(Math.hypot(dx, dy))} km`,
    x: left.toFixed(2),
    y: (top * 1.05).toFixed(2),
    left: `${left.toFixed(2)}%`,
    top: `${top.toFixed(2)}%`,
    labelLeft: c.cote === "droite" ? `calc(${left.toFixed(2)}% + 10px)` : "auto",
    labelRight: c.cote === "gauche" ? `calc(${(100 - left).toFixed(2)}% + 10px)` : "auto",
    align: c.cote === "gauche" ? "right" : "left",
    delai: 120 + i * 90,
    delaiPoint: 600 + i * 90,
  };
});

const conditions = [
  ["Minimum de commande", site.livraison.minimum],
  ["Frais de livraison", site.livraison.frais],
  ["Délai estimé", site.livraison.delai],
];

const heure = (t: string) => {
  const [h, m] = t.split(":");
  return m === "00" ? `${Number(h)} h` : `${Number(h)} h ${m}`;
};
const horaires = site.horaires.semaine.map(([jour, creneaux]) => ({
  jour,
  creneaux: creneaux.length ? creneaux.map(([a, b]) => `${heure(a)} – ${heure(b)}`).join(" · ") : "Fermé",
}));
const tel = `tel:${site.telephoneInternational}`;
const nombre = enLettres(communes.length);
---

<section id="actions" aria-labelledby="titre-actions" class="actions">
  <div class="contenu">
    <p class="surtitre" data-reveal="up">À table</p>
    <h2 id="titre-actions" class="titre-section titre" data-reveal="up" data-delay="60">Réserver, commander, <em>venir.</em></h2>

    <div class="colonnes">
      <div id="reserver" class="bloc" data-cta-zone="reserver">
        <h3 data-reveal="up">Réserver une table</h3>
        <p class="chapo" data-reveal="up">
          Choisissez la date, l’heure et le nombre de couverts. La réservation se fait en ligne avec TheFork, sans quitter la page.
        </p>
        <div class="plate module" data-reveal="plate" data-reservation data-etat="repos" data-src={site.liens.thefork}>
          <div class="couverture">
            <div class="couverture-lueur" aria-hidden="true"></div>
            <div class="repos">
              <p class="slogan">Votre table, en quelques clics.</p>
              <button type="button" class="btn btn-primary choisir" data-choisir-date>Choisir une date</button>
              <p class="mention">Le module de réservation est fourni par TheFork, qui peut déposer des cookies. Il ne se charge qu’à votre demande.</p>
            </div>
            <div class="chargement" role="status">
              <p class="chargement-texte">Chargement du module de réservation…</p>
              <div class="barre-chargement"><span data-chargeur></span></div>
            </div>
          </div>
        </div>
        <div class="liens">
          <a href={site.liens.thefork} target="_blank" rel="noopener" class="accent">Ouvrir dans un nouvel onglet</a>
          <span class="par-tel">Par téléphone : <a href={tel} class="clair chiffres">{site.telephone}</a></span>
        </div>
        <p class="a-valider note">Bloquant avant mise en ligne : le widget TheFork affiche encore « Basilic &amp; Co Béziers ». Faire renommer la fiche dans TheFork Manager.</p>
      </div>

      <div class="droite">
        <div id="commander" class="bloc" data-cta-zone="commander">
          <h3 data-reveal="up">Commander</h3>
          <p class="chapo chapo-court" data-reveal="up">À emporter ou en livraison.</p>
          {
            site.liens.obypay ? (
              <a class="btn btn-primary en-ligne" href={commande.href} target="_blank" rel="noopener">
                Commander en ligne
              </a>
            ) : (
              <div class="bientot" data-reveal="up">
                <p class="bientot-titre">
                  <span class="point point-grand" aria-hidden="true" />
                  La commande en ligne ouvre très bientôt.
                </p>
                <p class="bientot-texte">En attendant, appelez-nous.</p>
                <a class="btn btn-primary appeler chiffres" href={tel}>
                  Appeler le {site.telephone}
                </a>
              </div>
            )
          }
          <p class="a-valider note">
            Lien Obypay à renseigner (liens.obypay dans src/config/site.ts) : tous les boutons Commander y mèneront. Emplacement prévu ici pour la fidélité (Hey Pongo ou Obypay, outil à choisir).
          </p>
        </div>

        <div id="livraison" class="bloc">
          <h3 data-reveal="up">Livraison</h3>
          <p class="chapo" data-reveal="up">Béziers et {nombre} communes autour.</p>
          <div class="livraison">
            <div class="plan" role="img" aria-label={`Plan schématique : la pizzeria au centre de Béziers et les ${nombre} communes livrées autour`}>
              <svg aria-hidden="true" viewBox="0 0 100 105" preserveAspectRatio="none" class="plan-svg">
                <circle cx="50" cy="52.5" r="28.75" fill="none" stroke="rgba(243,242,242,0.18)" stroke-width="1" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"></circle>
                {
                  communes.map((c) => (
                    <line
                      data-reveal="draw"
                      data-delay={c.delai}
                      x1="50"
                      y1="52.5"
                      x2={c.x}
                      y2={c.y}
                      pathLength="1"
                      stroke-dasharray="1"
                      stroke-dashoffset="0"
                      stroke="rgba(250,203,141,0.42)"
                      stroke-width="0.35"
                    />
                  ))
                }
              </svg>
              <span class="echelle" aria-hidden="true">5 km</span>
              {
                communes.map((c) => (
                  <>
                    <span class="plan-point" aria-hidden="true" data-reveal="pop" data-delay={c.delaiPoint} style={`left:${c.left}; top:${c.top};`} />
                    <span class="plan-nom" aria-hidden="true" style={`top:${c.top}; left:${c.labelLeft}; right:${c.labelRight}; text-align:${c.align};`}>
                      {c.etiquette}
                    </span>
                  </>
                ))
              }
              <span class="plan-pizzeria" aria-hidden="true" data-reveal="pop"></span>
              <span class="plan-legende" aria-hidden="true">La Pizzeria · Béziers</span>
            </div>
            <ul role="list" class="communes">
              <li>Béziers<span>la pizzeria</span></li>
              {
                communes.map((c) => (
                  <li>
                    {c.nom}
                    <span class="chiffres">{c.km}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <dl class="conditions">
            {
              conditions.map(([libelle, valeur]) => (
                <div>
                  <dt class="libelle">{libelle}</dt>
                  <dd>{valeur ? valeur : <span class="tag tag-outline a-confirmer">à confirmer</span>}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>

    <div id="venir" class="venir">
      <figure>
        <div class="plate facade" data-reveal="plate">
          <div class="parallaxe" data-par="0.06">
            <Picture
              src={facade}
              formats={["avif", "webp"]}
              widths={[640, 960, 1280, 1536]}
              sizes="(min-width: 1000px) 46vw, 100vw"
              alt="La devanture le soir : enseigne bleu nuit aux lettres dorées, au numéro 43 des Allées Paul Riquet"
              class="image"
              pictureAttributes={{ class: "image-cadre" }}
            />
          </div>
        </div>
        <figcaption class="legende">Repérez l’enseigne bleu nuit, au numéro 43.</figcaption>
      </figure>
      <div class="trouver">
        <h3 data-reveal="up">Nous trouver</h3>
        <address data-reveal="up">{site.adresse.rue}<br />{site.adresse.codePostal} {site.adresse.ville}</address>
        <p class="coordonnees chiffres" data-reveal="up">Occitanie, France · {site.adresse.latitude}, {site.adresse.longitude}</p>
        <div class="trouver-boutons" data-reveal="up">
          <a class="btn btn-primary itineraire" href={site.liens.itineraire} target="_blank" rel="noopener">Itinéraire</a>
          <a class="btn btn-secondary maps" href={site.liens.carte} target="_blank" rel="noopener">Voir sur Google Maps</a>
        </div>

        <div class="horaires-tete">
          <h4>Horaires</h4>
          {!site.horaires.confirmes && <span class="tag tag-outline">à confirmer</span>}
        </div>
        <table class="table horaires" data-horaires>
          <caption class="sr-only">Horaires d’ouverture de la semaine</caption>
          <tbody>
            {
              horaires.map((h) => (
                <tr data-jour={h.jour.toLowerCase()}>
                  <th scope="row">
                    {h.jour}
                    <span class="aujourdhui" />
                  </th>
                  <td class="chiffres">{h.creneaux}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <dl class="contact">
          <div>
            <dt class="libelle">Téléphone</dt>
            <dd><a href={tel} class="clair chiffres">{site.telephone}</a></dd>
          </div>
          <div>
            <dt class="libelle">E-mail</dt>
            <dd>{site.email ? <a href={`mailto:${site.email}`} class="clair">{site.email}</a> : <span class="tag tag-outline">à confirmer</span>}</dd>
          </div>
          <div>
            <dt class="libelle">Paiement</dt>
            <dd>{site.paiements}</dd>
          </div>
          <div>
            <dt class="libelle">Avis Google</dt>
            <dd class="chiffres">
              {site.avisGoogle.note} · {site.avisGoogle.nombre}, relevé le {site.avisGoogle.releve}
              {
                site.avisGoogle.ficheVerifiee && (
                  <>
                    {" · "}
                    <a href={site.avisGoogle.lien} target="_blank" rel="noopener" class="accent">
                      Lire les avis
                    </a>
                  </>
                )
              }
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .actions {
    position: relative;
    padding: clamp(88px, 11vw, 160px) clamp(16px, 3vw, 44px) clamp(72px, 9vw, 128px);
    border-top: 1px solid var(--color-divider);
  }
  .contenu {
    max-width: 1320px;
    margin: 0 auto;
  }
  .titre {
    margin-bottom: clamp(40px, 5vw, 72px);
    text-wrap: initial;
  }
  .colonnes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(48px, 6vw, 96px);
    align-items: start;
  }
  .bloc {
    scroll-margin-top: 84px;
    min-width: 0;
  }
  .bloc h3,
  .trouver h3 {
    margin: 0 0 10px;
    font-weight: 500;
    font-size: 34px;
    line-height: 1.1;
  }
  .chapo {
    margin: 0 0 22px;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
  }
  .chapo-court {
    margin-bottom: 20px;
  }
  .note {
    margin: 16px 0 0;
  }
  /* Liens du texte : couleur du texte, soulignés */
  .clair,
  .clair:hover {
    color: var(--color-text);
  }

  /* — module de réservation — */
  .module {
    position: relative;
    height: clamp(560px, 74vh, 700px);
    overflow: hidden;
    overflow: clip;
    background: #f8f4f4;
    filter: none;
  }
  .module :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .module[data-etat="pret"] :global(iframe) {
    opacity: 1;
  }
  .couverture {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(24px, 4vw, 48px);
    background: #211f1e;
    color: var(--color-text);
  }
  .module[data-etat="pret"] .couverture {
    display: none;
  }
  .couverture-lueur {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 80% 100%, rgba(196, 81, 58, 0.22), rgba(33, 31, 30, 0) 70%);
    pointer-events: none;
  }
  .repos,
  .chargement {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .chargement,
  .module[data-etat="chargement"] .repos {
    display: none;
  }
  .module[data-etat="chargement"] .chargement {
    display: flex;
  }
  .slogan {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.15;
    max-width: 16ch;
  }
  .choisir {
    min-height: 50px;
    padding: 0 24px;
    font-size: 18px;
  }
  .mention {
    margin: 0;
    max-width: 44ch;
    font-size: 13px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-text) 68%, transparent);
  }
  .chargement-texte {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 26px;
    font-style: italic;
  }
  .barre-chargement {
    position: relative;
    width: min(320px, 100%);
    height: 1px;
    overflow: hidden;
    background: var(--color-divider);
  }
  .barre-chargement span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    background: var(--color-accent-300);
  }
  .liens {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 16px;
    font-size: 15px;
  }
  .par-tel {
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
  }

  /* — commander — */
  .droite {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5vw, 72px);
  }
  .en-ligne {
    min-height: 52px;
    padding: 0 26px;
    font-size: 19px;
  }
  .bientot {
    padding: 22px 0;
    border-top: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
  }
  .bientot-titre {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 8px;
    font-family: var(--font-heading);
    font-size: 24px;
    line-height: 1.25;
  }
  .point-grand {
    width: 8px;
    height: 8px;
    box-shadow: 0 0 12px 2px rgba(196, 81, 58, 0.75);
  }
  .bientot-texte {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
  }
  .appeler {
    min-height: 50px;
    padding: 0 22px;
    font-size: 18px;
  }

  /* — livraison — */
  .livraison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 28px;
    align-items: center;
  }
  .plan {
    position: relative;
    aspect-ratio: 1 / 1.05;
    max-width: 340px;
    width: 100%;
  }
  .plan-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Le rayon de 5 km, posé sur le bord gauche du cercle (en haut, il chevauchait Lignan-sur-Orb) */
  .echelle {
    position: absolute;
    left: 21.25%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
    background: #1c1a19;
    padding: 0 4px;
  }
  .plan-point {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f4da90;
    box-shadow: 0 0 10px 2px rgba(242, 211, 140, 0.55);
    transform: translate(-50%, -50%);
  }
  .plan-nom {
    position: absolute;
    transform: translateY(-50%);
    max-width: 31%;
    font-size: 12px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-text) 86%, transparent);
  }
  .plan-pizzeria {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-tomato);
    box-shadow:
      0 0 0 4px rgba(196, 81, 58, 0.25),
      0 0 18px 4px rgba(196, 81, 58, 0.6);
    transform: translate(-50%, -50%);
  }
  /* Au-dessus du point (en dessous, elle chevauchait Villeneuve-lès-Béziers) */
  .plan-legende {
    position: absolute;
    left: 50%;
    top: calc(50% - 12px);
    transform: translate(-50%, -100%);
    font-family: var(--font-heading);
    font-size: 15px;
    font-style: italic;
    white-space: nowrap;
    color: var(--color-accent-300);
  }
  .communes {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-divider);
  }
  .communes li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-divider);
    font-family: var(--font-heading);
    font-size: 20px;
  }
  .communes li span {
    font-family: var(--font-body);
    font-size: 13px;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-text) 66%, transparent);
  }
  .conditions {
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }
  .conditions > div {
    padding-top: 12px;
    border-top: 1px solid var(--color-divider);
  }
  .conditions dt {
    letter-spacing: 0.12em;
  }
  .conditions dd {
    margin: 6px 0 0;
    font-family: var(--font-heading);
    font-size: 21px;
  }
  .a-confirmer {
    font-family: var(--font-body);
    font-size: 12px;
  }

  /* — nous trouver — */
  .venir {
    scroll-margin-top: 84px;
    margin-top: clamp(72px, 9vw, 136px);
    padding-top: clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--color-divider);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .facade {
    position: relative;
    aspect-ratio: 1536 / 932;
    overflow: hidden;
    overflow: clip;
    background: #0b0a09;
  }
  .parallaxe {
    position: absolute;
    left: 0;
    right: 0;
    top: -8%;
    bottom: -8%;
  }
  .facade :global(.image-cadre) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .facade :global(.image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .legende {
    margin-top: 10px;
    font-size: 13px;
    font-style: italic;
    color: color-mix(in srgb, var(--color-text) 66%, transparent);
  }
  .trouver {
    min-width: 0;
  }
  .trouver h3 {
    margin-bottom: 14px;
  }
  address {
    margin: 0;
    font-style: normal;
    font-family: var(--font-heading);
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.15;
  }
  .coordonnees {
    margin: 8px 0 22px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-text) 66%, transparent);
  }
  .trouver-boutons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .itineraire {
    min-height: 48px;
    padding: 0 22px;
    font-size: 17px;
  }
  .maps {
    min-height: 48px;
    padding: 0 20px;
    font-size: 17px;
  }
  .horaires-tete {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 40px 0 6px;
  }
  .horaires-tete h4 {
    margin: 0;
    font-weight: 500;
    font-size: 24px;
  }
  .horaires-tete .tag {
    font-size: 12px;
  }
  .horaires {
    font-size: 15px;
  }
  .horaires th {
    padding: 9px 9px 9px 0;
    text-align: left;
    font-weight: 400;
    font-size: 15px;
    border-bottom: 1px solid var(--color-divider);
  }
  .horaires td {
    padding: 9px 0;
    text-align: right;
  }
  /* Le jour même, repéré par le script (fuseau de Paris) */
  .horaires tr[aria-current="date"] {
    color: var(--color-accent-300);
  }
  .aujourdhui {
    font-size: 12px;
    font-style: italic;
    margin-left: 8px;
    color: var(--color-accent-300);
  }
  .contact {
    margin: 32px 0 0;
    display: grid;
    gap: 14px;
  }
  .contact > div {
    display: grid;
    grid-template-columns: minmax(0, 8.5em) minmax(0, 1fr);
    gap: 12px;
  }
  .contact dt {
    letter-spacing: 0.12em;
    padding-top: 3px;
  }
  .contact dd {
    margin: 0;
    font-size: 16px;
  }
  .contact .tag {
    font-size: 12px;
  }
</style>
