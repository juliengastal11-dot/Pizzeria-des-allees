---
import { Picture } from "astro:assets";
import facade from "../assets/images/facade-nuit.jpg";
import { commande, enLettres, site } from "../config/site";

// Plan schématique de la livraison : la pizzeria au centre, chaque commune à sa vraie direction et distance
const KX = 111.32 * Math.cos((site.adresse.latitude * Math.PI) / 180);
const KY = 110.574;
const communes = site.livraison.communes.map((c, i) => {
  const dx = (c.longitude - site.adresse.longitude) * KX;
  const dy = (c.latitude - site.adresse.latitude) * KY;
  const left = 50 + (dx / 8) * 46;
  const top = 50 - (dy / 8.4) * 46;
  return {
    nom: c.nom,
    etiquette: c.etiquette,
    km: `≈ ${Math.round(Math.hypot(dx, dy))} km`,
    x: left.toFixed(2),
    y: (top * 1.05).toFixed(2),
    left: `${left.toFixed(2)}%`,
    top: `${top.toFixed(2)}%`,
    labelLeft: c.cote === "droite" ? `calc(${left.toFixed(2)}% + 10px)` : "auto",
    labelRight: c.cote === "gauche" ? `calc(${(100 - left).toFixed(2)}% + 10px)` : "auto",
    align: c.cote === "gauche" ? "right" : "left",
    delai: 120 + i * 90,
    delaiPoint: 600 + i * 90,
  };
});

const conditions = [
  ["Minimum de commande", site.livraison.minimum],
  ["Frais de livraison", site.livraison.frais],
  ["Délai estimé", site.livraison.delai],
];

const heure = (t: string) => {
  const [h, m] = t.split(":");
  return m === "00" ? `${Number(h)} h` : `${Number(h)} h ${m}`;
};
const horaires = site.horaires.semaine.map(([jour, creneaux]) => ({
  jour,
  creneaux: creneaux.length ? creneaux.map(([a, b]) => `${heure(a)} – ${heure(b)}`).join(" · ") : "Fermé",
}));
const tel = `tel:${site.telephoneInternational}`;
const nombre = enLettres(communes.length);
---

<section aria-labelledby="titre-actions" class="section actions">
  <div class="conteneur">
    <p class="surtitre" data-reveal="up">À table</p>
    <h2 id="titre-actions" class="titre" data-reveal="up" data-delay="60">Réserver, commander, <em>venir.</em></h2>

    <div class="colonnes">
      <div id="reserver" class="bloc reserver panneau" data-cta-zone="reserver">
        <h3 data-reveal="up">Réserver une table</h3>
        <p class="chapo" data-reveal="up">
          Choisissez la date, l’heure et le nombre de couverts. La réservation se fait en ligne avec TheFork, sans quitter la page.
        </p>
        <div class="module" data-reveal="fade" data-reservation data-etat="repos" data-src={site.liens.thefork}>
          <div class="couverture">
            <div class="couverture-orbe" aria-hidden="true"></div>
            <div class="repos">
              <p class="slogan">Votre table, en quelques clics.</p>
              <button type="button" class="btn btn-primary btn-grand" data-choisir-date>Choisir une date</button>
              <p class="mention">Le module de réservation est fourni par TheFork, qui peut déposer des cookies. Il ne se charge qu’à votre demande.</p>
            </div>
            <div class="chargement" role="status">
              <p class="chargement-texte">Chargement du module de réservation…</p>
              <div class="barre-chargement"><span data-chargeur></span></div>
            </div>
          </div>
        </div>
        <div class="liens">
          <a href={site.liens.thefork} target="_blank" rel="noopener">Ouvrir dans un nouvel onglet</a>
          <span class="par-tel">Par téléphone : <a href={tel} class="chiffres">{site.telephone}</a></span>
        </div>
        <p class="a-valider note">Bloquant avant mise en ligne : le widget TheFork affiche encore « Basilic &amp; Co Béziers ». Faire renommer la fiche dans TheFork Manager.</p>
      </div>

      <div class="droite">
        <div id="commander" class="bloc commander" data-cta-zone="commander">
          <h3 data-reveal="up">Commander</h3>
          <p class="chapo" data-reveal="up">À emporter ou en livraison.</p>
          {
            site.liens.obypay ? (
              <a class="btn btn-inverse btn-grand" href={commande.href} target="_blank" rel="noopener">
                Commander en ligne
              </a>
            ) : (
              <div class="bientot" data-reveal="up">
                <p class="bientot-titre">La commande en ligne ouvre très bientôt.</p>
                <p class="bientot-texte">En attendant, appelez-nous.</p>
                <a class="btn btn-inverse btn-grand chiffres" href={tel}>
                  Appeler le {site.telephone}
                </a>
              </div>
            )
          }
          <p class="a-valider note">
            Lien Obypay à renseigner (liens.obypay dans src/config/site.ts) : tous les boutons Commander y mèneront. Emplacement prévu ici pour la fidélité (Hey Pongo ou Obypay, outil à choisir).
          </p>
        </div>

        <div id="livraison" class="bloc livraison panneau">
          <h3 data-reveal="up">Livraison</h3>
          <p class="chapo" data-reveal="up">Béziers et {nombre} communes autour.</p>
          <div class="carte-livraison">
            <div class="plan" role="img" aria-label={`Plan schématique : la pizzeria au centre de Béziers et les ${nombre} communes livrées autour`}>
              <svg aria-hidden="true" viewBox="0 0 100 105" preserveAspectRatio="none" class="plan-svg">
                <circle cx="50" cy="52.5" r="28.75" fill="none" stroke="var(--color-hairline-strong)" stroke-width="1" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"></circle>
                {
                  communes.map((c) => (
                    <line
                      data-reveal="draw"
                      data-delay={c.delai}
                      x1="50"
                      y1="52.5"
                      x2={c.x}
                      y2={c.y}
                      pathLength="1"
                      stroke-dasharray="1"
                      stroke-dashoffset="0"
                      stroke="rgba(12, 10, 9, 0.28)"
                      stroke-width="0.35"
                    />
                  ))
                }
              </svg>
              <span class="echelle" aria-hidden="true">5 km</span>
              {
                communes.map((c) => (
                  <>
                    <span class="plan-point" aria-hidden="true" data-reveal="pop" data-delay={c.delaiPoint} style={`left:${c.left}; top:${c.top};`} />
                    <span class="plan-nom" aria-hidden="true" style={`top:${c.top}; left:${c.labelLeft}; right:${c.labelRight}; text-align:${c.align};`}>
                      {c.etiquette}
                    </span>
                  </>
                ))
              }
              <span class="plan-pizzeria" aria-hidden="true" data-reveal="pop"></span>
              <span class="plan-legende" aria-hidden="true">La Pizzeria · Béziers</span>
            </div>
            <ul role="list" class="communes">
              <li>Béziers<span>la pizzeria</span></li>
              {
                communes.map((c) => (
                  <li>
                    {c.nom}
                    <span class="chiffres">{c.km}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <dl class="conditions">
            {
              conditions.map(([libelle, valeur]) => (
                <div>
                  <dt class="libelle">{libelle}</dt>
                  <dd>{valeur ? valeur : <span class="badge badge-outline">à confirmer</span>}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>

    <div id="venir" class="venir">
      <figure data-reveal="up">
        <div class="facade photo-cadre">
          <Picture
            src={facade}
            formats={["avif", "webp"]}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1248px) 560px, (min-width: 1024px) 46vw, 100vw"
            alt="La devanture le soir : enseigne bleu nuit aux lettres dorées, au numéro 43 des Allées Paul Riquet"
            class="image"
            pictureAttributes={{ class: "image-cadre" }}
          />
        </div>
        <figcaption>Repérez l’enseigne bleu nuit, au numéro 43.</figcaption>
      </figure>
      <div class="trouver">
        <h3 data-reveal="up">Nous trouver</h3>
        <address data-reveal="up">{site.adresse.rue}<br />{site.adresse.codePostal} {site.adresse.ville}</address>
        <p class="coordonnees chiffres" data-reveal="up">Occitanie, France · {site.adresse.latitude}, {site.adresse.longitude}</p>
        <div class="trouver-boutons" data-reveal="up">
          <a class="btn btn-primary" href={site.liens.itineraire} target="_blank" rel="noopener">Itinéraire</a>
          <a class="btn btn-outline" href={site.liens.carte} target="_blank" rel="noopener">Voir sur Google Maps</a>
        </div>

        <div class="horaires-tete">
          <h4>Horaires</h4>
          {!site.horaires.confirmes && <span class="badge badge-outline">à confirmer</span>}
        </div>
        <table class="table" data-horaires>
          <caption class="sr-only">Horaires d’ouverture de la semaine</caption>
          <tbody>
            {
              horaires.map((h) => (
                <tr data-jour={h.jour.toLowerCase()}>
                  <th scope="row">
                    {h.jour}
                    <span class="aujourdhui" />
                  </th>
                  <td class="chiffres">{h.creneaux}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <dl class="contact">
          <div>
            <dt class="libelle">Téléphone</dt>
            <dd><a href={tel} class="chiffres">{site.telephone}</a></dd>
          </div>
          <div>
            <dt class="libelle">E-mail</dt>
            <dd>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span class="badge badge-outline">à confirmer</span>}</dd>
          </div>
          <div>
            <dt class="libelle">Paiement</dt>
            <dd>{site.paiements}</dd>
          </div>
          <div>
            <dt class="libelle">Avis Google</dt>
            <dd class="chiffres">
              {site.avisGoogle.note} · {site.avisGoogle.nombre}, relevé le {site.avisGoogle.releve}
              {
                site.avisGoogle.ficheVerifiee && (
                  <>
                    {" · "}
                    <a href={site.avisGoogle.lien} target="_blank" rel="noopener">
                      Lire les avis
                    </a>
                  </>
                )
              }
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .titre {
    margin-bottom: var(--space-xxl);
  }
  .colonnes {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .colonnes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .droite {
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
  }
  .bloc {
    scroll-margin-top: calc(var(--hauteur-entete) + var(--space-lg));
    min-width: 0;
  }
  .bloc h3 {
    margin-bottom: var(--space-sm);
    font-size: 28px;
  }
  .chapo {
    max-width: 52ch;
    margin-bottom: var(--space-lg);
  }
  .note {
    margin-top: var(--space-base);
  }
  @media (min-width: 640px) {
    .panneau {
      padding: var(--space-xl);
    }
  }

  /* Module de réservation */
  .module {
    position: relative;
    height: clamp(560px, 74vh, 700px);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    overflow: clip;
  }
  .module :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .module[data-etat="pret"] :global(iframe) {
    opacity: 1;
  }
  .couverture {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(24px, 4vw, 48px);
    background: var(--color-canvas-soft);
  }
  .module[data-etat="pret"] .couverture {
    display: none;
  }
  .couverture-orbe {
    position: absolute;
    right: -12%;
    bottom: -16%;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--color-orb-peach) 0%, var(--color-orb-rose) 50%, transparent 100%);
    opacity: 0.85;
    pointer-events: none;
  }
  .repos,
  .chargement {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-base);
  }
  .chargement,
  .module[data-etat="chargement"] .repos {
    display: none;
  }
  .module[data-etat="chargement"] .chargement {
    display: flex;
  }
  .slogan {
    max-width: 14ch;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }
  .mention {
    max-width: 44ch;
    font-size: 13px;
    letter-spacing: 0;
  }
  .chargement-texte {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 26px;
    font-style: italic;
    font-weight: 300;
  }
  .barre-chargement {
    position: relative;
    width: min(320px, 100%);
    height: 2px;
    background: var(--color-hairline-strong);
    overflow: hidden;
    overflow: clip;
  }
  .barre-chargement span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    background: var(--color-ink);
  }
  .liens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin-top: var(--space-base);
    font-size: 15px;
  }

  /* Commander : la carte sombre en vedette */
  .commander {
    padding: var(--space-lg);
    border-radius: var(--radius-xl);
    background: var(--color-surface-dark);
    color: var(--color-on-dark-soft);
  }
  @media (min-width: 640px) {
    .commander {
      padding: var(--space-xl);
    }
  }
  .commander h3 {
    color: #fff;
  }
  .commander .chapo {
    margin-bottom: var(--space-lg);
  }
  .bientot-titre {
    margin-bottom: var(--space-xs);
    color: #fff;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 300;
    line-height: 1.2;
  }
  .bientot-texte {
    margin-bottom: var(--space-lg);
  }
  .commander .note {
    border-color: var(--color-on-dark-soft);
    background: transparent;
    color: var(--color-on-dark-soft);
  }

  /* Livraison */
  .carte-livraison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-lg);
    align-items: center;
  }
  .plan {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1.05;
    justify-self: center;
  }
  .plan-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Rayon de 5 km, sur le bord gauche du cercle : à l'écart des noms de communes */
  .echelle {
    position: absolute;
    left: 21.25%;
    top: 50%;
    padding: 0 4px;
    background: var(--color-surface);
    color: var(--color-body);
    font-size: 11px;
    letter-spacing: 0.08em;
    transform: translate(-50%, -50%);
  }
  .plan-point {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ink);
    transform: translate(-50%, -50%);
  }
  .plan-nom {
    position: absolute;
    max-width: 31%;
    color: var(--color-ink);
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0;
    transform: translateY(-50%);
  }
  .plan-pizzeria {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 6px var(--color-orb-peach);
    transform: translate(-50%, -50%);
  }
  /* Au-dessus du point : en dessous, elle chevaucherait Villeneuve-lès-Béziers */
  .plan-legende {
    position: absolute;
    left: 50%;
    top: calc(50% - 16px);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    white-space: nowrap;
    transform: translate(-50%, -100%);
  }
  .communes {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .communes li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 10px 0;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-ink);
    font-size: 16px;
  }
  .communes li:last-child {
    border-bottom: 0;
  }
  .communes li span {
    color: var(--color-body);
    font-size: 14px;
    white-space: nowrap;
  }
  .conditions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-base);
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-hairline);
  }
  .conditions dd {
    margin: var(--space-xs) 0 0;
    color: var(--color-ink);
    font-size: 16px;
    font-weight: 500;
  }

  /* Nous trouver */
  .venir {
    display: grid;
    gap: var(--space-xxl);
    align-items: start;
    margin-top: var(--space-section);
    padding-top: var(--space-section);
    border-top: 1px solid var(--color-hairline);
    scroll-margin-top: var(--hauteur-entete);
  }
  @media (min-width: 1024px) {
    .venir {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 80px;
    }
  }
  /* La photo reste en vue pendant qu'on lit les horaires */
  @media (min-width: 1024px) {
    .venir > figure {
      position: sticky;
      top: calc(var(--hauteur-entete) + var(--space-lg));
    }
  }
  .facade {
    position: relative;
    aspect-ratio: 1536 / 932;
    border-radius: var(--radius-xl);
    background: var(--color-surface-strong);
  }
  .facade :global(.image-cadre) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .facade :global(.image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: var(--space-sm);
    font-size: 14px;
    letter-spacing: 0;
  }
  .trouver {
    min-width: 0;
  }
  .trouver h3 {
    margin-bottom: var(--space-base);
    font-size: 28px;
  }
  address {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 40px);
    font-style: normal;
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }
  .coordonnees {
    margin: var(--space-sm) 0 var(--space-lg);
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  .trouver-boutons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .horaires-tete {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: var(--space-xxl) 0 var(--space-xs);
  }
  /* Le jour même, repéré par le script (fuseau de Paris) */
  .table tr[aria-current="date"] {
    background: var(--color-surface);
  }
  .table tr[aria-current="date"] th,
  .table tr[aria-current="date"] td {
    font-weight: 500;
    color: var(--color-ink);
  }
  .table tr[aria-current="date"] th {
    border-radius: var(--radius-md) 0 0 var(--radius-md);
  }
  .table tr[aria-current="date"] td {
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .aujourdhui:not(:empty) {
    margin-left: var(--space-xs);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  .contact {
    display: grid;
    gap: 0;
    margin: var(--space-xl) 0 0;
  }
  .contact > div {
    display: grid;
    grid-template-columns: minmax(0, 8.5em) minmax(0, 1fr);
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-hairline);
  }
  .contact > div:last-child {
    border-bottom: 0;
  }
  .contact dt {
    padding-top: 2px;
  }
  .contact dd {
    margin: 0;
    color: var(--color-ink);
  }
</style>
