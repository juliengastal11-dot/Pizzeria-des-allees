---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Maison from "../components/Maison.astro";
import Carte from "../components/Carte.astro";
import Actions from "../components/Actions.astro";
import Footer from "../components/Footer.astro";
import BarreMobile from "../components/BarreMobile.astro";
import MenuMobile from "../components/MenuMobile.astro";
import FenetreLegale from "../components/FenetreLegale.astro";
---

<Layout>
  <a href="#contenu" class="evitement">Aller au contenu</a>
  <Header />
  <main id="contenu">
    <Hero />
    <Maison />
    <Carte />
    <Actions />
  </main>
  <Footer />
  <BarreMobile />
  <MenuMobile />
  <FenetreLegale />
</Layout>

<script>
  import "../scripts/animations";
  import "../scripts/interface";
  import "../scripts/carte";
  import "../scripts/reservation";
  import "../scripts/devanture";
</script>
